    <decisions>
        <name>Check_Existing_Member</name>
        <label>Check Existing Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Group_joining_policy</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_If_already_a_member</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Groups</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ShowExistingMemeberError</targetReference>
            </connector>
            <label>Check If already a member</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_requirement</name>
        <label>Check requirement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Membership</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Open</defaultConnectorLabel>
        <rules>
            <name>If_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Group_joining_policy.Joining_Requirement__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Closednotificationscreen</targetReference>
            </connector>
            <label>If Closed</label>
        </rules>
        <rules>
            <name>If_Approval_based</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Group_joining_policy.Joining_Requirement__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approval Based</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Membership_for_Approval</targetReference>
            </connector>
            <label>If Approval based</label>
        </rules>
        <rules>
            <name>Invite_Only</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Group_joining_policy.Joining_Requirement__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Invite Only</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>InviteOnlyScreen</targetReference>
            </connector>
            <label>Invite Only</label>
        </rules>
    </decisions>
